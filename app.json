
{
  "expo": {
    "name": "EsportsIndia",
    "slug": "MyNewApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.jeevan12.mynewapp"
    },
    "android": {
      "package": "com.jeevan12.mynewapp",
      "googleServicesFile": "./google-services.json",
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#141E30",
      "translucent": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-video",
      "expo-web-browser",
      "expo-notifications",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6973227795015320~4199598750",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3d595d0e-f1cd-4953-aec1-d6db77214b68"
      }
    }
  }
}
